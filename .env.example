# ─────────────────────────────────────────────────────────────
# Aplicación
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Alias legacy del backend Python. Es opcional: NODE_ENV tiene prioridad.
# ENVIRONMENT=development

# Zona horaria: el backend fija el proceso en UTC al arrancar (MIG-43).
# No la configures en otro valor: el arranque la reemplaza y advierte.
# TZ=UTC

# ─────────────────────────────────────────────────────────────
# Base de datos
#
# Opción A (Neon, preprod, producción): una sola URL. Neon ya incluye
# sslmode=require; no agregues DB_SSL salvo que la URL no lo traiga.
# ─────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://usuario:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Opción B (desarrollo local): variables separadas.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=cafecito

# Pool y TLS
# DB_SSL=false
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=240000
# DB_CONNECT_TIMEOUT_MS=10000

# Esquema: en desarrollo y contra un host local se crea solo.
# NUNCA lo actives contra la base compartida de Neon.
# DB_SYNCHRONIZE=true
# DB_LOGGING=false
# DB_MIGRATIONS_RUN=false

# ─────────────────────────────────────────────────────────────
# Autenticación (se usa en MIG-23 / MIG-25)
# ─────────────────────────────────────────────────────────────
SECRET_KEY=dev-only-secret-change-me-in-production-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─────────────────────────────────────────────────────────────
# CORS (se usa en MIG-20). Orígenes separados por coma.
# ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
